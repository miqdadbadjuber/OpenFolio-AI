# Copy this file to `.env.local` for local development and set the values.
# The same variable names are configured in the Vercel dashboard for production.

# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio key).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted. Reserved for future use.
APP_URL="http://localhost:3001"

# --- Firebase Admin (server-side auth & quota) ---
# Create a service account in the Firebase console (Project settings > Service accounts)
# and download the JSON. Use its project_id, client_email, and private_key values below.
# The private key must be wrapped in quotes; literal newlines can be escaped as \n.
FIREBASE_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- CORS ---
# Comma-separated list of allowed origins for API requests.
CORS_ORIGIN="http://localhost:3001"

# --- Custom Firebase Web config (client-side) ---
# Optional: if you are NOT using the auto-provisioned `firebase-applet-config.json`,
# set the web config of your own Firebase project here (Project settings > General > Your apps).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Cloudinary (image uploads) ---
# Required for the image upload endpoint (/api/upload).
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
