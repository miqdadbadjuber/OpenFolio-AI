# =============================================================
# OpenFolio — Environment Variables
# =============================================================
# Salin file ini ke `.env` lalu isi nilainya.
#   cp .env.example .env
# `.env` sudah digitignore — aman, tidak akan ke-push ke GitHub.
# Untuk production, set nama variabel yang SAMA di dashboard Vercel
# (Settings > Environment Variables).
#
# Satu file `.env` dipakai dua-duanya:
#   - Express server  → dibaca `dotenv.config()` (server/app.ts)
#   - Client (Vite)   → variabel berprefix VITE_ di-embed ke bundle
# =============================================================

# ------------------------------------------------------------------
# FIREBASE WEB CONFIG (CLIENT) — WAJIB
# ------------------------------------------------------------------
# Config web app untuk SPA. Ambil dari:
#   Firebase Console → pilih project → Project settings → Your apps
#   → SDK setup and configuration → lihat blok `const firebaseConfig = { ... }`.
#
# CATATAN: ini PUBLIC key (melekat di bundle client), bukan secret server.
# Semua VITE_FIREBASE_* WAJIB terisi, kalau tidak app tampil "not configured".
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Opsional — hanya untuk Firebase Analytics; kode app tidak membacanya.
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------
# FIREBASE ADMIN (SERVER) — WAJIB untuk auth & quota
# ------------------------------------------------------------------
# Untuk verifikasi token anonim + baca quota di server.
# Buat service account: Firebase Console → Project settings
#   → Service accounts → Generate new private key (dapat file JSON).
# Pakai project_id, client_email, dan private_key dari file itu.
# private_key WAJIB dibungkus tanda kutip; newline boleh ditulis \n.
FIREBASE_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ------------------------------------------------------------------
# GEMINI AI (SERVER) — untuk fitur AI
# ------------------------------------------------------------------
# Google AI Studio API key. Kalau kosong, fitur AI nonaktif
# (app tetap jalan, tapi tanpa generate/edit).
GEMINI_API_KEY=""

# ------------------------------------------------------------------
# CLOUDINARY (SERVER) — upload gambar (/api/upload)
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------
# WEB APP (opsional — default aman)
# ------------------------------------------------------------------
# PORT server Express (default 3001).
PORT="3001"

# Origin yang diizinkan akses API, dipisah koma tanpa spasi.
CORS_ORIGIN="http://localhost:3001"

# URL publik app. Belum dipakai kode (reserved).
APP_URL="http://localhost:3001"
